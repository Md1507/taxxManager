@page "/ho-so/{id:guid}/kich-ban"
@model TaxManager.Web.Pages.ForecastScenariosModel
@using TaxManager.Web.Pages
@using TaxManager.Core.Forecasting
@using TaxManager.Data.TaxRules
@functions {
    string Coverage(TaxManager.Data.Forecasting.ForecastScenarioView view, bool withBonus) => string.Join("; ",
        Enum.GetValues<ForecastStatus>().Select(state =>
            (state switch { ForecastStatus.Actual => "Thực tế", ForecastStatus.Planned => "Dự kiến", _ => "Giả định" }) + ": " +
            view.Input.Months.Count(month => (withBonus && view.AdditionalBonus is not null && month.Month == view.BonusMonth
                ? ForecastStatus.Assumed : new[] { month.Gross!.Status, month.Insurance!.Status, month.Dependents!.Status }
                    .Concat(view.Input.Bonuses.Where(b => b.Month == month.Month).Select(b => b.Amount.Status)).Max()) == state) + "/12"));
}
@{
    ViewData["Title"] = "Hai kịch bản";
    ViewData["ProfileId"] = Model.Comparison?.DocumentId;
    string Money(decimal value) => ForecastModel.FormatAmount(value) + " đ";
}
<p><a asp-page="/Forecast" asp-route-id="@Model.ProfileId" asp-fragment="tong-quan">Trở lại hồ sơ</a></p>
<div class="page-heading"><div><h1>Hai kịch bản năm 2026</h1>
<p>So sánh nghĩa vụ thuế khi thử thêm một khoản thưởng.</p></div></div>
@if (Model.Error is not null) {
    <p role="alert">@Model.Error</p>
    <p><a asp-page="/ForecastScenarios" asp-route-id="@Model.ProfileId">Mở bản lưu mới nhất</a></p>
} else if (Model.Comparison is { } view) {
    <p class="hint">Phiên bản @view.Revision. Chỉ dùng dữ liệu đã lưu; kết quả so sánh không được lưu vào hồ sơ hoặc lịch sử.</p>
    @if (!ViewData.ModelState.IsValid) {
        <div class="error-summary" role="alert" tabindex="-1"><h2>Kiểm tra khoản thưởng</h2><ul>
        @foreach (var entry in ViewData.ModelState.Where(e => e.Value!.Errors.Count > 0)) {
            @foreach (var error in entry.Value!.Errors) { <li><a href="#@entry.Key">@error.ErrorMessage</a></li> }
        }
        </ul></div>
    }
    <form method="post" class="input-panel scenario-form" data-scenario-form>
        <h2>Thử thêm thưởng</h2>
        <p>Thưởng tiền chịu thuế từ nơi trả lương hiện tại, cộng ngoài gross. Khoản này mang trạng thái Giả định.</p>
        <input type="hidden" asp-for="Revision" />
        <div class="form-grid scenario-fields">
            <div><label asp-for="BonusMonth">Tháng nhận</label><input asp-for="BonusMonth" type="number" min="1" max="12" placeholder="1–12" />
            <span class="error" id="error-BonusMonth" asp-validation-for="BonusMonth"></span></div>
            <div><label asp-for="BonusAmount">Số tiền thưởng</label><input asp-for="BonusAmount" type="text" inputmode="decimal" placeholder="Ví dụ: 10.000.000" />
            <span class="error" id="error-BonusAmount" asp-validation-for="BonusAmount"></span></div>
        </div>
        <noscript><p class="hint">Khi tắt JavaScript, nhập số không phân nhóm như 10000000,50.</p></noscript>
        <div class="actions"><button type="submit" class="primary">So sánh</button></div>
    </form>
    @if (view.Completeness.MissingObligation.Count > 0) {
        <section class="empty-state"><h2>Chưa đủ dữ liệu tính nghĩa vụ năm</h2>
        <p>Bổ sung và lưu các đầu vào sau trước khi so sánh. Không tự thay phần chưa biết bằng 0.</p><ul>
        @foreach (var group in view.Completeness.MissingObligation.GroupBy(m => m.Kind)) {
            <li>@(group.Key switch { ForecastInputKind.Gross => "Lương gross", ForecastInputKind.Insurance => "Bảo hiểm", _ => "Người phụ thuộc" }): tháng @string.Join(", ", group.Select(m => m.Month)).</li>
        }</ul>
        <a asp-page="/Forecast" asp-route-id="@view.DocumentId" asp-route-month="@view.Completeness.MissingObligation[0].Month" asp-fragment="sua-thang">Nhập bổ sung</a></section>
    } else if (view.Results is { } results) {
        <section class="input-panel" aria-labelledby="scenario-heading"><h2 id="scenario-heading">Nghĩa vụ thuế năm ước tính</h2>
        <p data-stale-comparison role="status" hidden>Khoản thưởng đang nhập đã thay đổi. Chọn So sánh để cập nhật kết quả bên dưới.</p>
        <div class="scenario-results">
            <div><h3>Cơ sở</h3><p class="scenario-amount" id="base-obligation">@Money(results.Base.Obligation)</p>
            <p class="hint" id="base-coverage">@Coverage(view, false).</p></div>
            @if (view.AdditionalBonus is not null) {
                <div><h3>Thêm thưởng giả định</h3><p class="scenario-amount" id="bonus-obligation">@Money(results.WithBonus.Obligation)</p>
                <p class="hint" id="bonus-coverage">@Coverage(view, true).</p></div>
            }
        </div>
        @if (view.AdditionalBonus is { } bonus) {
            <p><partial name="Shared/_ForecastStatus" model="ForecastStatus.Assumed" /> Thử thêm @Money(bonus.Value) vào tháng @view.BonusMonth. Các khoản đã lưu được giữ nguyên.</p>
            var change = results.WithBonus.Obligation - results.Base.Obligation;
            <p class="notice">@(change == 0 ? "Nghĩa vụ thuế không đổi:" : change > 0 ? "Thuế tăng thêm:" : "Thuế giảm:") <span id="scenario-tax-change">@Money(Math.Abs(change))</span></p>
        } else { <p>Chưa nhập khoản thưởng muốn thử. Nhập tháng và số tiền phía trên để tạo kịch bản thứ hai.</p> }
        <p class="hint">Một tháng chỉ là thực tế khi gross, bảo hiểm, người phụ thuộc và mọi khoản thưởng của tháng đều là thực tế.</p>
        <p>Khấu trừ trong hồ sơ cơ sở: @view.Completeness.WithholdingMonths/12 tháng đã nhập.
        @if (view.Completeness.MissingWithholdingMonths.Count > 0) { <span>Còn thiếu tháng @string.Join(", ", view.Completeness.MissingWithholdingMonths).</span> }</p>
        <p class="hint">Chỉ so sánh nghĩa vụ thuế. Chưa ước tính nộp thêm hoặc nộp thừa cho thưởng giả định vì chưa có khấu trừ tương ứng. Hai kịch bản không tạo khoảng bảo đảm hoặc xác suất.</p>
        <p class="hint">Tính lúc @ForecastModel.LocalTime(view.CalculatedAt) giờ Việt Nam, từ cùng phiên bản dữ liệu và cùng bộ luật.</p>
        </section>
        @if (view.AdditionalBonus is not null) {
            <section aria-labelledby="scenario-steps"><h2 id="scenario-steps">Bước tính so sánh</h2>
            <div class="table-scroll" role="region" aria-label="Bảng bước tính hai kịch bản" tabindex="0"><table class="scenario-table">
            <thead><tr><th scope="col">Chỉ tiêu</th><th class="money" scope="col">Cơ sở</th><th class="money" scope="col">Thêm thưởng</th></tr></thead><tbody>
            @foreach (var row in new (string Label, decimal Base, decimal Bonus)[] {
                ("Tổng thu nhập chịu thuế", results.Base.Details.GrossIncome, results.WithBonus.Details.GrossIncome),
                ("Thưởng cộng ngoài gross", results.Base.Details.BonusTotal, results.WithBonus.Details.BonusTotal),
                ("Thưởng đã gồm gross, không cộng trùng", results.Base.Details.BonusAlreadyInGross, results.WithBonus.Details.BonusAlreadyInGross),
                ("Bảo hiểm nhập tay", results.Base.Details.Insurance, results.WithBonus.Details.Insurance),
                ("Giảm trừ bản thân", results.Base.Details.PersonalDeduction, results.WithBonus.Details.PersonalDeduction),
                ("Giảm trừ người phụ thuộc", results.Base.Details.DependentDeduction, results.WithBonus.Details.DependentDeduction),
                ("Thu nhập tính thuế", results.Base.Details.TaxableIncome, results.WithBonus.Details.TaxableIncome),
                ("Nghĩa vụ thuế năm", results.Base.Obligation, results.WithBonus.Obligation) }) {
                <tr><th scope="row">@row.Label</th><td class="money">@Money(row.Base)</td><td class="money">@Money(row.Bonus)</td></tr>
            }
            </tbody></table></div><p class="hint">Thuế dùng biểu năm sau khi tổng hợp thu nhập và giảm trừ cả năm; không cộng thuế của 12 tháng để thay thuế năm.</p></section>
        }
        <details><summary>Căn cứ và phạm vi</summary>
        <p>Chỉ hỗ trợ cá nhân cư trú năm 2026, một nơi trả lương, thưởng tiền chịu thuế, bảo hiểm nhập tay và người phụ thuộc theo tháng. Kết quả chỉ tham khảo.</p>
        <p>Trạng thái pháp lý độc lập với trạng thái dữ liệu; các bộ quy tắc tham khảo hiện chưa được xác minh (Unverified).</p>
        @{ var sourceBases = new List<TaxManager.Core.LegalBasis>(); }
        @foreach (var registration in view.Rules) {
            var rule = AnnualRuleGraphCodec.Decode(registration.Graph);
            <p>Luật @rule.Id, phiên bản @rule.Version, kỳ @registration.PeriodFrom.ToString("dd/MM/yyyy") – @registration.PeriodTo.ToString("dd/MM/yyyy").</p>
            @foreach (var basis in new[] { rule.AnnualSalaryRules!.TaxRules.TaxBasis, rule.AnnualSalaryRules.PeriodBasis, rule.CashBonusRules!.TaxableBasis, rule.CashBonusRules.TimingBasis }.Distinct()) {
                sourceBases.Add(basis);
                <p>@basis.DocumentNumber, điều @basis.Article, khoản @basis.Clause; @basis.Status. @basis.Summary
                </p>
            }
        }
        <partial name="Shared/_LegalSources" model="sourceBases" />
        </details>
    }
}
