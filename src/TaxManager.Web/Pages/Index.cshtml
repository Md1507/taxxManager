@page
@using System.Globalization
@using TaxManager.Data.CalculationHistory
@model TaxManager.Web.Pages.IndexModel
@functions {
    string Money(decimal value) => value.ToString("#,0.############################", CultureInfo.GetCultureInfo("vi-VN"));
    string Input(string[] values, int index) => index < values.Length ? values[index] ?? "" : "";
}
<!doctype html>
<html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Tính thuế lương</title><link rel="stylesheet" href="/site.css"></head>
<body><a href="#main">Đến nội dung</a><main id="main"><h1>Tính thuế lương theo tháng</h1><p class="notice">Dữ liệu giả — chỉ dành cho demo.</p>
<p>Kết quả chỉ mang tính tham khảo, không thay thế tư vấn thuế chính thức.</p>
<p><a href="/?handler=Sample">Dùng dữ liệu giả mẫu</a></p>
@if (Model.Error is not null) { <div role="alert" class="error">@Model.Error</div> }
<form method="post"><label for="year">Năm</label><select id="year" name="year"><option value="2025" selected="@(Model.Year == 2025)">2025</option><option value="2026" selected="@(Model.Year == 2026)">2026</option></select>
<p>Nhập số tiền không dùng dấu phân nhóm, dùng dấu phẩy cho phần lẻ.</p>
@for (var i = 0; i < 12; i++) { <fieldset class="month"><legend>Tháng @(i + 1)</legend><label>Lương <input name="gross" inputmode="decimal" value="@Input(Model.Gross, i)" required></label><label>Bảo hiểm nhập tay <input name="insurance" inputmode="decimal" value="@Input(Model.Insurance, i)" required></label><label>Thuế đã khấu trừ <input name="withheld" inputmode="decimal" value="@Input(Model.Withheld, i)" required></label></fieldset> }
<button type="submit">Tính 12 tháng</button></form>
@if (Model.Results is not null) {
<section><h2>Kết quả 12 tháng</h2><p>Kết quả chỉ mang tính tham khảo; dữ liệu giả.</p>
@foreach (var snapshot in Model.Results) {
<details><summary>Tháng @snapshot.Month — Thuế @Money(snapshot.Result.TotalTax.Value) đồng</summary>
<p>Luật @snapshot.Rules.RuleId, phiên bản @snapshot.Rules.Version, kỳ @snapshot.Rules.PeriodFrom – @snapshot.Rules.PeriodTo. Nguồn tham khảo References.</p>
<table><caption>Các bước tính</caption><tbody>
@foreach (var row in new (string Label, CalculationAmountSnapshot Amount)[] { ("Lương", snapshot.Result.GrossIncome), ("Bảo hiểm", snapshot.Result.Insurance), ("Giảm trừ bản thân", snapshot.Result.PersonalDeduction), ("Giảm trừ người phụ thuộc", snapshot.Result.DependentDeduction), ("Thu nhập tính thuế trước giới hạn", snapshot.Result.TaxableIncomeBeforeClamp), ("Thu nhập tính thuế", snapshot.Result.PitTaxableIncome), ("Thuế", snapshot.Result.TotalTax) }) {
<tr><th scope="row">@row.Label</th><td>@Money(row.Amount.Value)</td><td><partial name="_Basis" model="new TaxManager.Web.LegalCitations.BasisView(row.Label, snapshot, row.Amount.Basis)" /></td></tr> }
</tbody></table><p>Thuế đã khấu trừ: @Money(snapshot.Input.ActualWithheldTax)</p>
<table class="brackets"><caption>Từng bậc thuế</caption><thead><tr><th>Bậc</th><th>Thu nhập chịu thuế</th><th>Thuế</th><th>Căn cứ</th></tr></thead><tbody>
@foreach (var portion in snapshot.Result.Portions) { var basisView = new TaxManager.Web.LegalCitations.BasisView("bậc thuế", snapshot, portion.Basis); <tr><td data-label="Bậc">@Money(portion.LowerBound) – @(portion.UpperBound is null ? "trở lên" : Money(portion.UpperBound.Value)) (@Money(portion.Rate * 100)%)</td><td data-label="Thu nhập chịu thuế">@Money(portion.TaxableAmount)</td><td data-label="Thuế">@Money(portion.Tax)</td><td><partial name="_Basis" model="basisView" /></td></tr> }
</tbody></table></details> }
</section> }
</main><script src="/citation.js" defer></script></body></html>
