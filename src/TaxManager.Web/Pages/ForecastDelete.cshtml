@page
@model TaxManager.Web.Pages.ForecastDeleteModel
@{
    ViewData["Title"] = "Xóa hồ sơ";
    ViewData["ProfileId"] = Model.Id;
    ViewData["Context"] = "Hồ sơ thuế năm 2026 / xác nhận xóa";
}
<h1>Xóa hồ sơ dự báo?</h1>
<p class="history-id">Hồ sơ @Model.Id, bản lưu @Model.Revision.</p>
<p>Hồ sơ hiện hành sẽ bị xóa. Lịch sử và nhật ký audit mã hóa vẫn được giữ. Bản sao, WAL và vùng lưu vật lý có thể còn dữ liệu.</p>
<partial name="Shared/_Errors" />
<form method="post"><input type="hidden" asp-for="Id" /><input type="hidden" asp-for="Revision" />
<button class="danger" type="submit">Xác nhận xóa</button> <a asp-page="/Forecast" asp-route-id="@Model.Id">Hủy</a></form>
