@page "/ho-so/{id:guid}/doi-chieu"
@model TaxManager.Web.Pages.ForecastReconciliationModel
@using TaxManager.Web.Pages
@using TaxManager.Data.Forecasting
@using TaxManager.Core.Forecasting
@{
    ViewData["Title"] = "Đối chiếu nguồn";
    ViewData["ProfileId"] = Model.Profile?.DocumentId;
    string Money(decimal value) => ForecastModel.FormatAmount(value) + " đ";
}
<p><a asp-page="/Forecast" asp-route-id="@Model.ProfileId" asp-fragment="tong-quan">Trở lại hồ sơ</a></p>
<div class="page-heading"><div><h1>Đối chiếu nguồn</h1><p>So số từ công ty hoặc eTax với hồ sơ trong cùng kỳ.</p></div></div>
@if (Model.Error is not null) {
    <p role="alert">@Model.Error</p><p><a asp-page="/ForecastReconciliation" asp-route-id="@Model.ProfileId">Mở bản lưu mới nhất</a></p>
} else if (Model.Profile is { } profile) {
    <p class="hint">Phiên bản @profile.Revision, năm @profile.Input.Year. Phép đối chiếu không lưu vào hồ sơ hoặc lịch sử.</p>
    @if (!ViewData.ModelState.IsValid) {
        var fieldOrder = new[] { "Source", "SourceName", "SourceYear", "FromMonth", "ToMonth", "Metric", "Amount", "Status", "Note" };
        <div class="error-summary" role="alert" tabindex="-1" aria-labelledby="reconciliation-errors"><h2 id="reconciliation-errors">Kiểm tra số nguồn</h2><ul>
        @foreach (var entry in ViewData.ModelState.Where(e => e.Value!.Errors.Count > 0)
            .OrderBy(e => Array.IndexOf(fieldOrder, e.Key) is var index && index >= 0 ? index : fieldOrder.Length)) {
            @foreach (var error in entry.Value!.Errors) { <li><a href="#@entry.Key">@error.ErrorMessage</a></li> }
        }</ul></div>
    }
    <form method="post" class="input-panel reconciliation-form" data-reconciliation-form>
        <h2 id="reconciliation-input" tabindex="-1">Số từ nguồn ngoài</h2>
        <input type="hidden" asp-for="Revision" />
        <fieldset class="choice-field"><legend>Nguồn</legend><div class="choice-row">
        @foreach (var source in Enum.GetValues<ReconciliationSource>()) {
            <label><input asp-for="Source" type="radio" value="@source" id="@(source == ReconciliationSource.Company ? "Source" : "Source_" + source)" />@ForecastReconciliationModel.SourceLabel(source)</label>
        }</div><span class="error" id="error-Source" asp-validation-for="Source"></span></fieldset>
        <div><label asp-for="SourceName">Tên tài liệu hoặc mô tả nguồn</label><input asp-for="SourceName" maxlength="200" placeholder="Ví dụ: Phiếu lương tháng 6 từ công ty" />
        <span class="error" id="error-SourceName" asp-validation-for="SourceName"></span></div>
        <div class="reconciliation-period">
            <div><label asp-for="SourceYear">Năm nguồn</label><input asp-for="SourceYear" type="number" min="1" max="9999" /><span class="error" id="error-SourceYear" asp-validation-for="SourceYear"></span></div>
            <div><label asp-for="FromMonth">Từ tháng</label><input asp-for="FromMonth" type="number" min="1" max="12" placeholder="1" /><span class="error" id="error-FromMonth" asp-validation-for="FromMonth"></span></div>
            <div><label asp-for="ToMonth">Đến tháng</label><input asp-for="ToMonth" type="number" min="1" max="12" placeholder="12" /><span class="error" id="error-ToMonth" asp-validation-for="ToMonth"></span></div>
        </div>
        <p class="hint">Một tháng: nhập cùng tháng đầu và cuối. Cả năm: từ tháng 1 đến 12.</p>
        <div class="form-grid">
            <div><label asp-for="Metric">Chỉ tiêu</label><select asp-for="Metric" aria-describedby="metric-help"><option value="">Chọn chỉ tiêu</option>
            @foreach (var metric in Enum.GetValues<ReconciliationMetric>()) { <option value="@metric">@ForecastReconciliationModel.MetricLabel(metric)</option> }
            </select><span class="error" id="error-Metric" asp-validation-for="Metric"></span></div>
            <div><label asp-for="Amount">Số tiền từ nguồn</label><input asp-for="Amount" type="text" inputmode="decimal" placeholder="Ví dụ: 1.500.000" /><span class="error" id="error-Amount" asp-validation-for="Amount"></span></div>
        </div>
        <partial name="Shared/_MoneyFormatHelp" />
        <p class="hint" id="metric-help">Gross là lương trước khấu trừ đã nhập, gồm thưởng đã nằm trong gross; chưa cộng thưởng ngoài gross. Thuế đã khấu trừ là số nguồn ghi, khác nghĩa vụ thuế ứng dụng tính.</p>
        <fieldset class="choice-field"><legend>Trạng thái số nguồn</legend><div class="choice-row">
        @foreach (var status in Enum.GetValues<ForecastStatus>()) {
            <label><input asp-for="Status" type="radio" value="@status" id="@(status == ForecastStatus.Actual ? "Status" : "Status_" + status)" />@(status switch { ForecastStatus.Actual => "Thực tế", ForecastStatus.Planned => "Dự kiến", _ => "Giả định" })</label>
        }</div><span class="error" id="error-Status" asp-validation-for="Status"></span></fieldset>
        <p class="hint">Nguồn không tự xác định trạng thái. Số giả định cần ghi cách hình thành bên dưới.</p>
        <label asp-for="Note">Ghi chú (không bắt buộc với thực tế hoặc dự kiến)</label><textarea asp-for="Note" rows="2" maxlength="2000"></textarea><span class="error" id="error-Note" asp-validation-for="Note"></span>
        <noscript><p class="hint">Khi tắt JavaScript, nhập số không phân nhóm như 1500000,50.</p></noscript>
        <div class="form-actions" role="group" aria-label="Thao tác đối chiếu"><span class="hint">Không sửa số trong hồ sơ.</span><div class="actions"><button type="submit" class="primary">Đối chiếu số liệu</button></div></div>
    </form>
    @if (Model.Result is { } result) {
        <section aria-labelledby="reconciliation-heading"><h2 id="reconciliation-heading" tabindex="-1" data-reconciliation-result>Kết quả đối chiếu</h2>
        <p data-stale-reconciliation role="status" hidden>Số nguồn đang nhập đã thay đổi. Chọn Đối chiếu số liệu để cập nhật kết quả bên dưới.</p>
        <p>@ForecastReconciliationModel.MetricLabel(Model.Metric!.Value), từ tháng @Model.FromMonth đến @Model.ToMonth năm @Model.SourceYear.</p>
        <p><strong>@ForecastReconciliationModel.SourceLabel(Model.Source!.Value):</strong> @Model.SourceName <partial name="Shared/_ForecastStatus" model="@Model.Status!.Value" /></p>
        @if (!string.IsNullOrEmpty(Model.Note)) { <p class="entry-note">@Model.Note</p> }
        <p class="hint">Nhập lúc @ForecastModel.LocalTime(Model.EnteredAt!.Value) giờ Việt Nam; thời điểm này không xác minh tính đúng của nguồn.</p>
        <p><a href="#reconciliation-input">Sửa số nguồn</a></p>
        <div class="table-scroll reconciliation-table-scroll" role="region" aria-label="Bảng đối chiếu số liệu" tabindex="0"><table class="reconciliation-table">
        <thead><tr><th scope="col">Chỉ tiêu</th><th scope="col" class="money">Hồ sơ</th><th scope="col" class="money">Nguồn nhập</th><th scope="col" class="money">Nguồn − hồ sơ</th></tr></thead>
        <tbody><tr><th scope="row">@ForecastReconciliationModel.MetricLabel(Model.Metric.Value)</th>
        <td class="money"><span id="profile-amount">@(result.Amount is { } amount ? Money(amount) : "Chưa so được")</span>
        @if (result.SameYear) {
            <p class="hint">@string.Join("; ", Enum.GetValues<ForecastStatus>().Select(s => (s switch { ForecastStatus.Actual => "Thực tế", ForecastStatus.Planned => "Dự kiến", _ => "Giả định" }) + ": " + result.Months.Count(m => m.Value?.Status == s) + "/" + result.Months.Count))</p>
        }</td><td class="money" id="source-amount">@Money(Model.Amount!.Value)</td>
        <td class="money">@if (Model.Difference is { } difference) {
            <span id="reconciliation-difference" class="@(difference > 0 ? "difference-positive" : difference < 0 ? "difference-negative" : null)">@(difference > 0 ? "+" : difference < 0 ? "−" : "")@Money(Math.Abs(difference))</span>
            <p>@(difference > 0 ? "Nguồn cao hơn hồ sơ" : difference < 0 ? "Nguồn thấp hơn hồ sơ" : "Hai số bằng nhau")</p>
        } else { <span>Chưa so được</span> }</td></tr></tbody></table></div>
        <dl class="reconciliation-mobile">
            <dt>Hồ sơ</dt><dd>@(result.Amount is { } mobileAmount ? Money(mobileAmount) : "Chưa so được")
            @if (result.SameYear) { <p class="hint">@string.Join("; ", Enum.GetValues<ForecastStatus>().Select(s => (s switch { ForecastStatus.Actual => "Thực tế", ForecastStatus.Planned => "Dự kiến", _ => "Giả định" }) + ": " + result.Months.Count(m => m.Value?.Status == s) + "/" + result.Months.Count))</p> }</dd>
            <dt>Nguồn nhập</dt><dd>@Money(Model.Amount!.Value)<p><partial name="Shared/_ForecastStatus" model="@Model.Status!.Value" /></p></dd>
            <dt>Nguồn − hồ sơ</dt><dd>@if (Model.Difference is { } mobileDifference) {
                <span class="@(mobileDifference > 0 ? "difference-positive" : mobileDifference < 0 ? "difference-negative" : null)">@(mobileDifference > 0 ? "+" : mobileDifference < 0 ? "−" : "")@Money(Math.Abs(mobileDifference))</span>
                <p class="hint">@(mobileDifference > 0 ? "Nguồn cao hơn hồ sơ" : mobileDifference < 0 ? "Nguồn thấp hơn hồ sơ" : "Hai số bằng nhau")</p>
            } else { <span>Chưa so được</span> }</dd>
        </dl>
        @if (!result.SameYear) { <p role="status">Hai số đang khác kỳ: hồ sơ năm @profile.Input.Year, nguồn năm @Model.SourceYear. Chọn cùng năm trước khi đối chiếu.</p> }
        else if (result.Amount is null) {
            var missing = result.Months.Where(m => m.Value is null).Select(m => m.Month).ToArray();
            <p role="status">Chưa có @ForecastReconciliationModel.MetricLabel(Model.Metric.Value).ToLowerInvariant() trong hồ sơ: tháng @string.Join(", ", missing). Chưa dùng tổng một phần để so với cả kỳ.</p>
            <p><a asp-page="/Forecast" asp-route-id="@profile.DocumentId" asp-route-month="@missing[0]" asp-fragment="sua-thang">Bổ sung số trong hồ sơ</a></p>
        }
        <p class="hint">Chênh lệch = số nguồn nhập trừ số hồ sơ, cùng chỉ tiêu và kỳ. Chênh lệch không kết luận công ty hoặc eTax sai, không phải tiền hoàn hoặc phải nộp thêm.</p>
        @if (result.SameYear) {
            <details><summary>Nguồn hồ sơ theo tháng</summary>
            <div class="table-scroll" role="region" aria-label="Nguồn và trạng thái từng tháng" tabindex="0"><table class="reconciliation-table"><thead><tr><th scope="col">Tháng</th><th scope="col" class="money">Số hồ sơ</th><th scope="col">Nguồn và thời điểm nhập</th><th scope="col">Ghi chú</th></tr></thead><tbody>
            @foreach (var month in result.Months) {
                <tr><th scope="row">@month.Month</th><td class="money">@if (month.Value is { } value) { @Money(value.Value)<partial name="Shared/_ForecastStatus" model="value.Status" /> } else { <span>Chưa nhập</span> }</td>
                <td>@if (month.Value is { } supplied) { <span>@(string.IsNullOrWhiteSpace(supplied.Source) ? "Chưa ghi nguồn" : supplied.Source)</span><p class="hint">@ForecastModel.LocalTime(supplied.EnteredAt) giờ Việt Nam</p> } else { <span>Chưa nhập</span> }</td>
                <td class="entry-note">@month.Value?.Note</td></tr>
            }</tbody></table></div></details>
        }</section>
    } else { <p>Nhập số từ công ty hoặc eTax cùng kỳ để bắt đầu đối chiếu.</p> }
}
