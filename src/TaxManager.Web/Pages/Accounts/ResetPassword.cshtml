@page "/tai-khoan/dat-lai-mat-khau"
@model TaxManager.Web.Pages.Accounts.ResetPasswordModel
@{ ViewData["Title"] = "Đặt mật khẩu mới"; ViewData["AccountErrorFallback"] = "Password"; }
<div class="page-heading"><div><h1>Đặt mật khẩu mới</h1></div></div>
@if (Model.Ready) {
<form method="post" class="input-panel" data-password-fields data-password-registration>
    <partial name="Shared/_AccountErrors" />
    <input type="hidden" asp-for="UserId" /><input type="hidden" asp-for="RequestId" /><input type="hidden" asp-for="Code" />
    <label asp-for="Password">Mật khẩu mới</label>
    <div class="password-input"><input asp-for="Password" type="password" autocomplete="new-password" minlength="8" maxlength="128" required aria-describedby="password-condition" /><partial name="Shared/_PasswordToggle" model='@("Password")' /></div>
    <p class="password-condition" id="password-condition" data-password-condition aria-live="polite" aria-atomic="true"><span data-condition-idle><partial name="Shared/_Icon" model='@("password-condition")' /></span><span data-condition-valid hidden><partial name="Shared/_Icon" model='@("check-circle")' /></span><span data-condition-invalid hidden><partial name="Shared/_Icon" model='@("warning")' /></span><span data-condition-message>8–128 ký tự, không chỉ gồm khoảng trắng.</span></p>
    <span class="error" id="error-Password" asp-validation-for="Password"></span>
    <label asp-for="ConfirmPassword">Nhập lại mật khẩu mới</label>
    <div class="password-input"><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" maxlength="128" required aria-describedby="password-match" /><partial name="Shared/_PasswordToggle" model='@("ConfirmPassword")' /></div>
    <p class="password-condition" id="password-match" data-password-match aria-live="polite" aria-atomic="true"><span data-condition-idle><partial name="Shared/_Icon" model='@("password-condition")' /></span><span data-condition-valid hidden><partial name="Shared/_Icon" model='@("check-circle")' /></span><span data-condition-invalid hidden><partial name="Shared/_Icon" model='@("warning")' /></span><span data-condition-message>Nhập lại mật khẩu để xác nhận.</span></p>
    <span class="error" id="error-ConfirmPassword" asp-validation-for="ConfirmPassword"></span>
    <div class="actions"><button type="submit" class="primary">Lưu mật khẩu mới</button><a class="button" asp-page="/Accounts/Login">Trở lại đăng nhập</a></div>
</form>
} else {
<div class="input-panel"><p role="status">Liên kết khôi phục không còn hợp lệ hoặc không thuộc tài khoản đang mở. Yêu cầu thư mới để tiếp tục.</p><div class="actions"><a class="button primary" asp-page="/Accounts/ForgotPassword">Yêu cầu liên kết mới</a></div></div>
}
