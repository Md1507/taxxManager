@page "/tai-khoan/quen-mat-khau"
@model TaxManager.Web.Pages.Accounts.ForgotPasswordModel
@{ ViewData["Title"] = "Quên mật khẩu"; ViewData["AccountErrorFallback"] = "Email"; }
<div class="page-heading"><div><h1>Quên mật khẩu</h1></div></div>
@if (Model.Sent) {
<div class="input-panel"><p role="status">Nếu email này đã được xác minh cho một tài khoản, bạn sẽ nhận được thư khôi phục. Kiểm tra cả thư rác; nếu chưa có thư, chờ một phút trước khi thử lại.</p><div class="actions"><a class="button primary" asp-page="/Accounts/Login">Trở lại đăng nhập</a></div></div>
} else {
<form method="post" class="input-panel">
    <partial name="Shared/_AccountErrors" />
    <label asp-for="Email">Email đã xác minh</label><input asp-for="Email" type="email" autocomplete="email" placeholder="ban@example.com" maxlength="254" aria-describedby="email-help" />
    <p class="hint" id="email-help">Dùng email bạn đã thêm và xác minh trong tài khoản.</p>
    <span class="error" id="error-Email" asp-validation-for="Email"></span>
    <div class="actions"><button type="submit" class="primary">Gửi liên kết khôi phục</button><a class="button" asp-page="/Accounts/Login">Trở lại đăng nhập</a></div>
</form>
}
