@page "/tai-khoan"
@model TaxManager.Web.Pages.Accounts.IndexModel
@{ ViewData["Title"] = "Tài khoản thử"; }
<h1>Tài khoản thử</h1>
<section class="input-panel"><h2>@User.Identity?.Name</h2>
    <p>Hồ sơ và bản sao đang mở thuộc kho thử của tài khoản này.</p>
    <p class="hint">Dữ liệu và tài khoản vẫn được giữ khi đăng xuất. Chức năng xuất hoặc xóa toàn bộ tài khoản chưa có ở bước này.</p>
    @if (Model.Acceptance is { } acceptance) {
        <p class="hint">Đã xác nhận nội dung ngày @TaxManager.Web.Accounts.LocalDataUse.DisplayVersion lúc @TaxManager.Web.Pages.ForecastModel.LocalTime(acceptance.AcceptedAt) giờ Việt Nam.</p>
        <p><a asp-page="/Accounts/DataUse">Xem nội dung đã xác nhận</a></p>
    } else { <p><a asp-page="/Accounts/DataUse">Đọc và xác nhận phạm vi dữ liệu thử</a></p> }
    <div class="actions"><a asp-page="/ForecastProfiles" class="button primary">Trở lại hồ sơ</a></div>
    <form method="post" asp-page-handler="Logout"><button type="submit">Đăng xuất</button></form>
</section>
