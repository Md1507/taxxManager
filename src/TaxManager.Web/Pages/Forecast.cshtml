@page
@model TaxManager.Web.Pages.ForecastModel
@{
    ViewData["Title"] = "Hồ sơ thuế năm 2026";
    ViewData["ProfileId"] = Model.ProfileId;
    ViewData["Context"] = Model.ProfileId is null ? "Hồ sơ thuế / năm 2026" : $"Hồ sơ năm 2026 / bản {Model.Revision}";
    var posted = HttpMethods.IsPost(ViewContext.HttpContext.Request.Method);
    var unsaved = posted && !Model.SavedInputConfirmed;
}
<p><a asp-page="/ForecastProfiles">Trở lại hồ sơ</a></p>
<div class="page-heading"><div><h1>Hồ sơ thuế năm 2026</h1><p>Cá nhân cư trú, một nơi trả lương.</p></div></div>
<form method="post" asp-page-handler="Preview" id="forecast-form" data-forecast-form autocomplete="off" data-unsaved="@(unsaved ? "true" : "false")">
<input type="hidden" asp-for="DraftToken" />
<input type="hidden" asp-for="ProfileId" /><input type="hidden" asp-for="Revision" />
@* Enter previews even when the visible action bar follows the row-removal buttons. *@
<button type="submit" hidden tabindex="-1" aria-hidden="true">Xem trước 12 tháng</button>
<partial name="Shared/_Errors" />
<div id="du-lieu" class="page-heading"><div><h2>Nhập lương theo giai đoạn</h2>
<p class="save-state" data-save-state role="status">@(unsaved ? "Bản xem trước chưa lưu. Lưu hồ sơ để giữ thay đổi." : Model.ProfileId is null ? "Hồ sơ mới, chưa lưu." : $"Đã mở bản lưu {Model.Revision}. Xem trước không lưu hồ sơ.")</p></div>
</div>
<noscript><p>Để nhập khi tắt JavaScript, dùng số không phân nhóm như 123456789,50.</p></noscript>
<fieldset class="form-region"><legend class="visually-hidden">Dữ liệu dự báo</legend><fieldset><legend>Giai đoạn lương</legend>
<div class="form-grid salary-period-grid"><div><label asp-for="FromMonth">Từ tháng</label><input asp-for="FromMonth" type="number" min="1" max="12" /><span class="error" asp-validation-for="FromMonth"></span></div><div><label asp-for="ToMonth">Đến tháng</label><input asp-for="ToMonth" type="number" min="1" max="12" /><span class="error" asp-validation-for="ToMonth"></span></div><div><label asp-for="Gross">Lương gross mỗi tháng (đồng)</label><input asp-for="Gross" type="text" inputmode="decimal" aria-describedby="salary-terms" /><span class="error" asp-validation-for="Gross"></span></div></div>


<partial name="Shared/_SalaryTerms" />
<p class="hint">Để trống khi chưa biết lương gross; không điền 0 để thay số chưa biết.</p>
<label asp-for="Status">Trạng thái</label><select asp-for="Status"><option value="Planned">Dự kiến</option><option value="Actual">Thực tế</option><option value="Assumed">Giả định</option></select><details open="@(ViewData.ModelState["Note"]?.Errors.Count > 0 ? "open" : null)"><summary>Thông tin lương giai đoạn</summary>
<label asp-for="Source">Nguồn</label><input asp-for="Source" />
<label asp-for="Note">Ghi chú hoặc lý do giả định</label><input asp-for="Note" /><span class="error" asp-validation-for="Note"></span></details></fieldset>
@for (var i = 0; i < Model.Periods.Count; i++) {
<fieldset><legend>Giai đoạn thay đổi @(i + 1)</legend>
<div class="form-grid salary-period-grid"><div><label asp-for="Periods[i].FromMonth">Từ tháng</label><input asp-for="Periods[i].FromMonth" type="number" min="1" max="12" /><span class="error" asp-validation-for="Periods[i].FromMonth"></span></div><div><label asp-for="Periods[i].ToMonth">Đến tháng</label><input asp-for="Periods[i].ToMonth" type="number" min="1" max="12" /><span class="error" asp-validation-for="Periods[i].ToMonth"></span></div><div><label asp-for="Periods[i].Gross">Lương gross mỗi tháng (đồng)</label><input asp-for="Periods[i].Gross" type="text" inputmode="decimal" /><span class="error" asp-validation-for="Periods[i].Gross"></span></div></div>


<label asp-for="Periods[i].Status">Trạng thái</label><select asp-for="Periods[i].Status"><option value="Planned">Dự kiến</option><option value="Actual">Thực tế</option><option value="Assumed">Giả định</option></select><details open="@(ViewData.ModelState[$"Periods[{i}].Note"]?.Errors.Count > 0 ? "open" : null)"><summary>Thông tin lương giai đoạn thay đổi</summary>
<label asp-for="Periods[i].Source">Nguồn</label><input asp-for="Periods[i].Source" />
<label asp-for="Periods[i].Note">Ghi chú hoặc lý do giả định</label><textarea name="Periods[@i].Note" id="Periods_@(i)__Note" rows="2">@(ViewData.ModelState[$"Periods[{i}].Note"]?.AttemptedValue ?? Model.Periods[i].Note)</textarea><span class="error" asp-validation-for="Periods[i].Note"></span></details>
<button type="submit" asp-page-handler="RemovePeriod" name="index" value="@i" formnovalidate>Bỏ giai đoạn @(i + 1)</button></fieldset> }
<button type="submit" asp-page-handler="AddPeriod" formnovalidate>Thêm giai đoạn thay đổi</button>
<section class="input-panel" aria-labelledby="bonuses-heading"><h2 id="bonuses-heading">Thưởng từ nơi trả lương hiện tại</h2>
<p>Nhập thưởng tiền thực tế hoặc dự kiến. Chọn đã gồm gross nếu khoản này đã nằm trong lương gross của tháng nhận.</p>
@for (var i = 0; i < Model.Bonuses.Count; i++) {
<fieldset><legend>Khoản thưởng @(i + 1)</legend>
<label asp-for="Bonuses[i].Month">Tháng nhận thưởng</label><input asp-for="Bonuses[i].Month" type="number" min="1" max="12" />
<label asp-for="Bonuses[i].Amount">Số tiền thưởng (đồng)</label><input asp-for="Bonuses[i].Amount" type="text" inputmode="decimal" /><span class="error" asp-validation-for="Bonuses[i].Amount"></span>
<label asp-for="Bonuses[i].Status">Trạng thái</label><select asp-for="Bonuses[i].Status"><option value="Actual">Thực tế</option><option value="Planned">Dự kiến</option></select>
<label asp-for="Bonuses[i].IncludedInGross">Đã gồm trong gross</label><select asp-for="Bonuses[i].IncludedInGross"><option value="false">Chưa gồm, cộng thêm</option><option value="true">Đã gồm trong gross</option></select>
<label asp-for="Bonuses[i].Source">Nguồn</label><input asp-for="Bonuses[i].Source" />
<label asp-for="Bonuses[i].Note">Ghi chú</label><textarea name="Bonuses[@i].Note" id="Bonuses_@(i)__Note" rows="2">@(ViewData.ModelState[$"Bonuses[{i}].Note"]?.AttemptedValue ?? Model.Bonuses[i].Note)</textarea>
</fieldset> }
<button type="submit" asp-page-handler="AddBonus" formnovalidate>Thêm khoản thưởng</button>
</section>
<section id="sua-thang" data-navigation-section="du-lieu" class="month-editor input-panel" aria-labelledby="month-editor-heading"><h2 id="month-editor-heading">Dữ liệu riêng theo tháng</h2><p>Chọn một tháng để chỉnh dữ liệu riêng. Gross để trống sẽ dùng lương theo giai đoạn.</p>
<div data-month-fallback class="month-fallback">
<label asp-for="SelectedMonth">Chọn tháng</label><select asp-for="SelectedMonth"><option value="0">Chọn tháng</option>@for (var month = 1; month <= 12; month++) { <option value="@month">Tháng @month</option> }</select>
<button type="submit" asp-page-handler="SelectMonth" asp-fragment="sua-thang" formnovalidate>Sửa tháng đã chọn</button>
</div>
<input type="hidden" name="EditingMonth" value="@Model.SelectedMonth" />
<div class="month-options" data-month-options role="group" aria-label="Chọn tháng cần sửa" hidden>
@for (var month = 0; month < 12; month++) {
    var hasData = Model.HasMonthData(month);
    var selected = Model.SelectedMonth == month + 1;
    <button type="submit" asp-page-handler="SelectMonth" asp-fragment="sua-thang" name="targetMonth" value="@(month + 1)" formnovalidate
        class="month-option @(hasData ? "has-data" : "")" aria-current="@(selected ? "true" : null)" aria-label="Tháng @(month + 1) @(hasData ? "đã có dữ liệu" : "chưa có dữ liệu")">
        <span>Tháng @(month + 1)</span><span class="month-state">@(selected ? "Đang sửa" : hasData ? "Đã nhập" : "Chưa nhập")</span>
    </button>
}
</div>

@for (var i = 0; i < 12; i++) {
<input type="hidden" asp-for="Exceptions[i].Month" />
@if (Model.SelectedMonth == i + 1) {
<fieldset><legend>Chỉnh tháng @(i + 1)</legend><p class="hint">Sửa dữ liệu rồi chọn Lưu hồ sơ ở thanh thao tác cuối form để lưu tháng này cùng các thay đổi còn lại. Ô gross trống dùng lại giai đoạn lương.</p>
<label asp-for="Exceptions[i].Gross">Gross ngoại lệ (đồng)</label><input asp-for="Exceptions[i].Gross" type="text" inputmode="decimal" /><span class="error" asp-validation-for="Exceptions[i].Gross"></span>
<label asp-for="Exceptions[i].Status">Trạng thái</label><select asp-for="Exceptions[i].Status"><option value="Planned">Dự kiến</option><option value="Actual">Thực tế</option><option value="Assumed">Giả định</option></select>
<label asp-for="Exceptions[i].Insurance">Bảo hiểm bắt buộc (đồng)</label><input asp-for="Exceptions[i].Insurance" type="text" inputmode="decimal" /><span class="error" asp-validation-for="Exceptions[i].Insurance"></span>
<label asp-for="Exceptions[i].InsuranceStatus">Trạng thái bảo hiểm</label><select asp-for="Exceptions[i].InsuranceStatus"><option value="Planned">Dự kiến</option><option value="Actual">Thực tế</option><option value="Assumed">Giả định</option></select>
<label asp-for="Exceptions[i].Dependents">Số người phụ thuộc</label><input asp-for="Exceptions[i].Dependents" type="number" min="0" /><span class="error" asp-validation-for="Exceptions[i].Dependents"></span>
<label asp-for="Exceptions[i].DependentsStatus">Trạng thái người phụ thuộc</label><select asp-for="Exceptions[i].DependentsStatus"><option value="Planned">Dự kiến</option><option value="Actual">Thực tế</option><option value="Assumed">Giả định</option></select>
<label asp-for="Exceptions[i].Withheld">Thuế đã hoặc dự kiến khấu trừ (đồng)</label><input asp-for="Exceptions[i].Withheld" type="text" inputmode="decimal" /><span class="error" asp-validation-for="Exceptions[i].Withheld"></span>
<label asp-for="Exceptions[i].WithheldStatus">Trạng thái khấu trừ</label><select asp-for="Exceptions[i].WithheldStatus"><option value="Planned">Dự kiến</option><option value="Actual">Thực tế</option><option value="Assumed">Giả định</option></select>
<details open="@(ViewData.ModelState.Keys.Any(k => k.StartsWith($"Exceptions[{i}].") && ViewData.ModelState[k]?.Errors.Count > 0) ? "open" : null)"><summary>Nguồn và ghi chú tháng @(i + 1)</summary>
<h3>Lương gross</h3>
<label asp-for="Exceptions[i].Source">Nguồn</label><input asp-for="Exceptions[i].Source" />
<label asp-for="Exceptions[i].Note">Ghi chú hoặc lý do giả định</label><input asp-for="Exceptions[i].Note" />
<h3>Bảo hiểm</h3>
<label asp-for="Exceptions[i].InsuranceSource">Nguồn bảo hiểm</label><input asp-for="Exceptions[i].InsuranceSource" />
<label asp-for="Exceptions[i].InsuranceNote">Ghi chú hoặc lý do giả định bảo hiểm</label><input asp-for="Exceptions[i].InsuranceNote" />
<h3>Người phụ thuộc</h3>
<label asp-for="Exceptions[i].DependentsSource">Nguồn người phụ thuộc</label><input asp-for="Exceptions[i].DependentsSource" />
<label asp-for="Exceptions[i].DependentsNote">Ghi chú hoặc lý do giả định người phụ thuộc</label><input asp-for="Exceptions[i].DependentsNote" />
<h3>Khấu trừ</h3>
<label asp-for="Exceptions[i].WithheldSource">Nguồn khấu trừ</label><input asp-for="Exceptions[i].WithheldSource" />
<label asp-for="Exceptions[i].WithheldNote">Ghi chú hoặc lý do giả định khấu trừ</label><input asp-for="Exceptions[i].WithheldNote" /></details>
<button type="submit" asp-page-handler="ConfirmClearMonth" formnovalidate>Xóa dữ liệu tháng này</button>
@if (Model.ConfirmClear) { <p>Xóa toàn bộ dữ liệu đã nhập của tháng này?</p><button type="submit" asp-page-handler="ClearMonth" formnovalidate>Xác nhận xóa tháng @Model.SelectedMonth</button> <button type="submit" asp-page-handler="SelectMonth" asp-fragment="sua-thang" formnovalidate>Hủy xóa</button> }
</fieldset>
} else {
<input type="hidden" asp-for="Exceptions[i].Gross" data-money /><input type="hidden" asp-for="Exceptions[i].Status" /><input type="hidden" asp-for="Exceptions[i].Source" /><input type="hidden" asp-for="Exceptions[i].Note" />
<input type="hidden" asp-for="Exceptions[i].Insurance" data-money /><input type="hidden" asp-for="Exceptions[i].InsuranceStatus" /><input type="hidden" asp-for="Exceptions[i].InsuranceSource" /><input type="hidden" asp-for="Exceptions[i].InsuranceNote" />
<input type="hidden" asp-for="Exceptions[i].Dependents" /><input type="hidden" asp-for="Exceptions[i].DependentsStatus" /><input type="hidden" asp-for="Exceptions[i].DependentsSource" /><input type="hidden" asp-for="Exceptions[i].DependentsNote" />
<input type="hidden" asp-for="Exceptions[i].Withheld" data-money /><input type="hidden" asp-for="Exceptions[i].WithheldStatus" /><input type="hidden" asp-for="Exceptions[i].WithheldSource" /><input type="hidden" asp-for="Exceptions[i].WithheldNote" />
} }
</section>
</fieldset>
@if (Model.Preview is not null) { <partial name="Shared/_ForecastMonths" model="Model" /> }
<section id="nguoi-phu-thuoc" class="input-panel" aria-labelledby="dependents-heading"><h2 id="dependents-heading">Người phụ thuộc theo giai đoạn</h2>
<p>Nhập số người theo khoảng tháng. Dữ liệu riêng của từng tháng được giữ ưu tiên; thông tin này không xác nhận đăng ký.</p>
@for (var i = 0; i < Model.DependentPeriods.Count; i++) {
<fieldset><legend>Giai đoạn người phụ thuộc @(i + 1)</legend>
<label asp-for="DependentPeriods[i].FromMonth">Từ tháng</label><input asp-for="DependentPeriods[i].FromMonth" type="number" min="1" max="12" />
<label asp-for="DependentPeriods[i].ToMonth">Đến tháng</label><input asp-for="DependentPeriods[i].ToMonth" type="number" min="1" max="12" />
<label asp-for="DependentPeriods[i].Count">Số người</label><input asp-for="DependentPeriods[i].Count" type="number" min="0" /><span class="error" asp-validation-for="DependentPeriods[i].Count"></span>
<label asp-for="DependentPeriods[i].Status">Trạng thái</label><select asp-for="DependentPeriods[i].Status"><option value="Actual">Thực tế</option><option value="Planned">Dự kiến</option><option value="Assumed">Giả định</option></select>
<label asp-for="DependentPeriods[i].Source">Nguồn</label><input asp-for="DependentPeriods[i].Source" />
<label asp-for="DependentPeriods[i].Note">Ghi chú hoặc lý do giả định</label><textarea name="DependentPeriods[@i].Note" id="DependentPeriods_@(i)__Note" rows="2">@(ViewData.ModelState[$"DependentPeriods[{i}].Note"]?.AttemptedValue ?? Model.DependentPeriods[i].Note)</textarea>
</fieldset> }
<button type="submit" asp-page-handler="AddDependentPeriod" formnovalidate>Thêm giai đoạn người phụ thuộc</button>
</section>
<section id="tong-quan"><div class="page-heading"><div><h2>Tổng quan năm 2026</h2><p>Tính từ bản dữ liệu đã lưu. Mỗi lần tính tạo một kết quả riêng.</p></div>
@if (Model.ProfileId is not null) { <button type="submit" asp-page-handler="Calculate">Tính thuế năm</button> }
</div>
@if (Model.ProfileId is null) { <p>Lưu hồ sơ trước khi tính thuế năm. Bạn vẫn có thể lưu khi chưa đủ dữ liệu.</p> }
else {
<nav class="forecast-related" aria-label="Phân tích hồ sơ">
    <a asp-page="/ForecastScenarios" asp-route-id="@Model.ProfileId" asp-route-revision="@Model.Revision"><partial name="Shared/_Icon" model='@("create")' /><span><strong>So sánh thưởng giả định</strong><span class="hint">Thử thêm thưởng, giữ nguyên hồ sơ đã lưu.</span></span></a>
    <a asp-page="/ForecastReconciliation" asp-route-id="@Model.ProfileId" asp-route-revision="@Model.Revision"><partial name="Shared/_Icon" model='@("compare")' /><span><strong>Đối chiếu nguồn</strong><span class="hint">So với số công ty hoặc eTax trong cùng kỳ.</span></span></a>
</nav>
}
</section>
<div class="form-actions" role="group" aria-label="Thao tác hồ sơ">
<span class="hint">Xem trước không lưu thay đổi.</span>
<div class="actions"><button type="submit"><partial name="Shared/_Icon" model='@("preview")' />Xem trước 12 tháng</button><button class="primary" type="submit" asp-page-handler="Save"><partial name="Shared/_Icon" model='@("save")' />Lưu hồ sơ</button></div>
</div>
</form>
@if (Model.Completeness is { MissingObligation.Count: > 0 } missing)
{
    <section role="status" class="empty-state"><h2>Chưa đủ dữ liệu tính nghĩa vụ năm</h2><p>Không tự điền 0 cho dữ liệu chưa biết. Hãy bổ sung và lưu hồ sơ.</p>
    <ul>@foreach (var item in missing.MissingObligation) { <li><button type="submit" form="forecast-form" asp-page-handler="SelectMonth" asp-fragment="sua-thang" name="targetMonth" value="@item.Month" formnovalidate>Sửa tháng @item.Month</button>: thiếu @(item.Kind switch { TaxManager.Core.Forecasting.ForecastInputKind.Gross => "lương gross", TaxManager.Core.Forecasting.ForecastInputKind.Insurance => "bảo hiểm", _ => "người phụ thuộc" }).</li> }</ul></section>
}
@if (Model.AnnualResult is not null) { <partial name="Shared/_AnnualResult" model="Model.AnnualResult" /> }
@if (Model.ProfileId is not null)
{
    <section class="forecast-history"><div class="page-heading"><div><h2>Kết quả năm đã lưu</h2><p>@(Model.AnnualHistory.Count == 0 ? "Chưa có kết quả tính năm. Tính thuế năm để lưu kết quả đầu tiên." : $"{Model.AnnualHistory.Count} kết quả tính, giữ riêng từng lần.")</p></div>
    </div>
    @if (Model.AnnualHistory.Count > 0) {
    <ul class="forecast-history-list">@foreach (var result in Model.AnnualHistory) { <li><a asp-page="/ForecastAnnualHistory" asp-route-id="@Model.ProfileId" asp-route-record="@result.HistoryId"><span>Kết quả ngày @TaxManager.Web.Pages.ForecastModel.LocalTime(result.CreatedAtUtc) giờ Việt Nam</span><span class="hint">Bản dữ liệu @result.InputRevision</span></a></li> }</ul>
    }
    </section>
}
@if (Model.ProfileId is not null) { <p class="forecast-delete"><a asp-page="/ForecastDelete" asp-route-id="@Model.ProfileId" asp-route-revision="@Model.Revision">Xem thao tác xóa hồ sơ</a></p> }
