@page
@model TaxManager.Web.Pages.ForecastModel
<!doctype html>
<html lang="vi"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Dự báo thuế năm 2026</title><link rel="stylesheet" href="/site.css" /></head>
<body><main>
<h1>Dự báo thuế năm 2026</h1>
<p>Demo local, chỉ dùng dữ liệu giả. Dành cho cá nhân cư trú có một nơi trả lương; kết quả chỉ tham khảo.</p>
<p>Chức năng đang phát triển: hiện chỉ xem trước lương theo tháng; chưa tính thuế hoặc lưu hồ sơ.</p>
<p><a href="/">Về tính thuế tháng</a></p>
<form method="post" asp-page-handler="Preview">
<div asp-validation-summary="All" class="error" role="alert" tabindex="-1" autofocus="@(!ViewData.ModelState.IsValid ? "autofocus" : null)"></div>
<button type="submit">Xem trước 12 tháng</button>
<fieldset><legend>Giai đoạn lương</legend>
<label asp-for="FromMonth">Từ tháng</label><input asp-for="FromMonth" type="number" min="1" max="12" /><span class="error" asp-validation-for="FromMonth"></span>
<label asp-for="ToMonth">Đến tháng</label><input asp-for="ToMonth" type="number" min="1" max="12" /><span class="error" asp-validation-for="ToMonth"></span>
<label asp-for="Gross">Lương gross mỗi tháng (đồng)</label><input asp-for="Gross" type="text" inputmode="decimal" /><span class="error" asp-validation-for="Gross"></span>
<p>Có thể tìm số lương gross trên phiếu lương; để trống khi chưa biết.</p>
<details open="@(ViewData.ModelState["Note"]?.Errors.Count > 0 ? "open" : null)"><summary>Thông tin lương giai đoạn</summary><label asp-for="Status">Trạng thái</label><select asp-for="Status"><option value="Planned">Dự kiến</option><option value="Actual">Thực tế</option><option value="Assumed">Giả định</option></select>
<label asp-for="Source">Nguồn</label><input asp-for="Source" />
<label asp-for="Note">Ghi chú hoặc lý do giả định</label><input asp-for="Note" /><span class="error" asp-validation-for="Note"></span></details>
@for (var i = 0; i < Model.Periods.Count; i++) {
<fieldset><legend>Giai đoạn thay đổi @(i + 1)</legend>
<label asp-for="Periods[i].FromMonth">Từ tháng</label><input asp-for="Periods[i].FromMonth" type="number" min="1" max="12" /><span class="error" asp-validation-for="Periods[i].FromMonth"></span>
<label asp-for="Periods[i].ToMonth">Đến tháng</label><input asp-for="Periods[i].ToMonth" type="number" min="1" max="12" /><span class="error" asp-validation-for="Periods[i].ToMonth"></span>
<label asp-for="Periods[i].Gross">Lương gross mỗi tháng (đồng)</label><input asp-for="Periods[i].Gross" type="text" inputmode="decimal" /><span class="error" asp-validation-for="Periods[i].Gross"></span>
<details open="@(ViewData.ModelState[$"Periods[{i}].Note"]?.Errors.Count > 0 ? "open" : null)"><summary>Thông tin lương giai đoạn thay đổi</summary><label asp-for="Periods[i].Status">Trạng thái</label><select asp-for="Periods[i].Status"><option value="Planned">Dự kiến</option><option value="Actual">Thực tế</option><option value="Assumed">Giả định</option></select>
<label asp-for="Periods[i].Source">Nguồn</label><input asp-for="Periods[i].Source" />
<label asp-for="Periods[i].Note">Ghi chú hoặc lý do giả định</label><input asp-for="Periods[i].Note" /><span class="error" asp-validation-for="Periods[i].Note"></span></details>
<button type="submit" asp-page-handler="RemovePeriod" name="index" value="@i" formnovalidate>Bỏ giai đoạn @(i + 1)</button></fieldset> }
<button type="submit" asp-page-handler="AddPeriod" formnovalidate>Thêm giai đoạn thay đổi</button>
<details open="@(Model.SelectedMonth > 0 ? "open" : null)"><summary>Dữ liệu riêng theo tháng</summary><p>Chọn tháng cần nhập hoặc chỉnh; không cần nhập nếu chưa có dữ liệu riêng.</p>
<label asp-for="SelectedMonth">Chọn tháng</label><select asp-for="SelectedMonth"><option value="0">Chọn tháng</option>@for (var month = 1; month <= 12; month++) { <option value="@month">Tháng @month</option> }</select>
<input type="hidden" name="EditingMonth" value="@Model.SelectedMonth" />
<button type="submit" asp-page-handler="SelectMonth" formnovalidate>Mở tháng đã chọn</button>
@for (var month = 0; month < 12; month++) { if (Model.HasMonthData(month)) { <button type="submit" asp-page-handler="SelectMonth" name="targetMonth" value="@(month + 1)" formnovalidate>Tháng @(month + 1) đã có dữ liệu</button> } }

@for (var i = 0; i < 12; i++) {
<input type="hidden" asp-for="Exceptions[i].Month" />
@if (Model.SelectedMonth == i + 1) {
<fieldset><legend>Chỉnh tháng @(i + 1)</legend>
<label asp-for="Exceptions[i].Gross">Gross ngoại lệ (đồng)</label><input asp-for="Exceptions[i].Gross" type="text" inputmode="decimal" /><span class="error" asp-validation-for="Exceptions[i].Gross"></span>
<details open="@(ViewData.ModelState[$"Exceptions[{i}].Gross"]?.Errors.Count > 0 ? "open" : null)"><summary>Thông tin gross ngoại lệ</summary><label asp-for="Exceptions[i].Status">Trạng thái</label><select asp-for="Exceptions[i].Status"><option value="Planned">Dự kiến</option><option value="Actual">Thực tế</option><option value="Assumed">Giả định</option></select>
<label asp-for="Exceptions[i].Source">Nguồn</label><input asp-for="Exceptions[i].Source" />
<label asp-for="Exceptions[i].Note">Ghi chú hoặc lý do giả định</label><input asp-for="Exceptions[i].Note" /></details>
<label asp-for="Exceptions[i].Insurance">Bảo hiểm bắt buộc (đồng)</label><input asp-for="Exceptions[i].Insurance" type="text" inputmode="decimal" /><span class="error" asp-validation-for="Exceptions[i].Insurance"></span>
<details open="@(ViewData.ModelState[$"Exceptions[{i}].Insurance"]?.Errors.Count > 0 ? "open" : null)"><summary>Thông tin bảo hiểm</summary><label asp-for="Exceptions[i].InsuranceStatus">Trạng thái bảo hiểm</label><select asp-for="Exceptions[i].InsuranceStatus"><option value="Planned">Dự kiến</option><option value="Actual">Thực tế</option><option value="Assumed">Giả định</option></select>
<label asp-for="Exceptions[i].InsuranceSource">Nguồn bảo hiểm</label><input asp-for="Exceptions[i].InsuranceSource" />
<label asp-for="Exceptions[i].InsuranceNote">Ghi chú hoặc lý do giả định bảo hiểm</label><input asp-for="Exceptions[i].InsuranceNote" /></details>
<label asp-for="Exceptions[i].Dependents">Số người phụ thuộc</label><input asp-for="Exceptions[i].Dependents" type="number" min="0" /><span class="error" asp-validation-for="Exceptions[i].Dependents"></span>
<details open="@(ViewData.ModelState[$"Exceptions[{i}].Dependents"]?.Errors.Count > 0 ? "open" : null)"><summary>Thông tin người phụ thuộc</summary><label asp-for="Exceptions[i].DependentsStatus">Trạng thái người phụ thuộc</label><select asp-for="Exceptions[i].DependentsStatus"><option value="Planned">Dự kiến</option><option value="Actual">Thực tế</option><option value="Assumed">Giả định</option></select>
<label asp-for="Exceptions[i].DependentsSource">Nguồn người phụ thuộc</label><input asp-for="Exceptions[i].DependentsSource" />
<label asp-for="Exceptions[i].DependentsNote">Ghi chú hoặc lý do giả định người phụ thuộc</label><input asp-for="Exceptions[i].DependentsNote" /></details>
<label asp-for="Exceptions[i].Withheld">Thuế đã hoặc dự kiến khấu trừ (đồng)</label><input asp-for="Exceptions[i].Withheld" type="text" inputmode="decimal" /><span class="error" asp-validation-for="Exceptions[i].Withheld"></span>
<details open="@(ViewData.ModelState[$"Exceptions[{i}].Withheld"]?.Errors.Count > 0 ? "open" : null)"><summary>Thông tin khấu trừ</summary><label asp-for="Exceptions[i].WithheldStatus">Trạng thái khấu trừ</label><select asp-for="Exceptions[i].WithheldStatus"><option value="Planned">Dự kiến</option><option value="Actual">Thực tế</option><option value="Assumed">Giả định</option></select>
<label asp-for="Exceptions[i].WithheldSource">Nguồn khấu trừ</label><input asp-for="Exceptions[i].WithheldSource" />
<label asp-for="Exceptions[i].WithheldNote">Ghi chú hoặc lý do giả định khấu trừ</label><input asp-for="Exceptions[i].WithheldNote" /></details>
<button type="submit" asp-page-handler="ConfirmClearMonth" formnovalidate>Xóa dữ liệu tháng này</button>
@if (Model.ConfirmClear) { <p>Xóa toàn bộ dữ liệu đã nhập của tháng này?</p><button type="submit" asp-page-handler="ClearMonth" formnovalidate>Xác nhận xóa tháng @Model.SelectedMonth</button> <button type="submit" asp-page-handler="SelectMonth" formnovalidate>Hủy xóa</button> }
</fieldset>
} else {
<input type="hidden" asp-for="Exceptions[i].Gross" /><input type="hidden" asp-for="Exceptions[i].Status" /><input type="hidden" asp-for="Exceptions[i].Source" /><input type="hidden" asp-for="Exceptions[i].Note" />
<input type="hidden" asp-for="Exceptions[i].Insurance" /><input type="hidden" asp-for="Exceptions[i].InsuranceStatus" /><input type="hidden" asp-for="Exceptions[i].InsuranceSource" /><input type="hidden" asp-for="Exceptions[i].InsuranceNote" />
<input type="hidden" asp-for="Exceptions[i].Dependents" /><input type="hidden" asp-for="Exceptions[i].DependentsStatus" /><input type="hidden" asp-for="Exceptions[i].DependentsSource" /><input type="hidden" asp-for="Exceptions[i].DependentsNote" />
<input type="hidden" asp-for="Exceptions[i].Withheld" /><input type="hidden" asp-for="Exceptions[i].WithheldStatus" /><input type="hidden" asp-for="Exceptions[i].WithheldSource" /><input type="hidden" asp-for="Exceptions[i].WithheldNote" />
} }
</details>
<button type="submit">Xem trước</button></fieldset></form>
@if (Model.Preview is not null) { <section><h2>Xem trước 12 tháng</h2>
@foreach (var conflict in Model.Preview.ConflictingMonths) { <p>Tháng @conflict là ngoại lệ và được giữ nguyên.</p> }
@foreach (var month in Model.ReplacedPeriodMonths) { <p>Tháng @month được thay bằng giai đoạn nhập sau.</p> }
<table class="forecast-preview"><thead><tr><th>Tháng</th><th>Lương</th><th>Trạng thái</th><th>Nguồn</th><th>Ghi chú</th><th>Ngày nhập</th></tr></thead><tbody>@foreach (var month in Model.Preview.Months) { <tr><th scope="row">Tháng @month.Key</th><td data-label="Lương">@(month.Value is null ? "Chưa nhập" : TaxManager.Web.Pages.ForecastModel.FormatAmount(month.Value.Value) + " đồng")</td><td data-label="Trạng thái">@(month.Value is null ? "" : month.Value.Status switch { TaxManager.Core.Forecasting.ForecastStatus.Actual => "Thực tế", TaxManager.Core.Forecasting.ForecastStatus.Planned => "Dự kiến", _ => "Giả định" })</td><td data-label="Nguồn">@month.Value?.Source</td><td data-label="Ghi chú">@month.Value?.Note</td><td data-label="Ngày nhập">@(month.Value?.EnteredAt.ToString("dd/MM/yyyy HH:mm 'UTC'", System.Globalization.CultureInfo.InvariantCulture))</td></tr> }
</tbody></table>
<h3>Bảo hiểm theo tháng</h3><p>Để trống nếu chưa biết; nhập 0 khi xác nhận không phát sinh.</p>
@foreach (var item in Model.InsurancePreview.OrderBy(x => x.Key)) {
<p>Bảo hiểm tháng @item.Key: @(item.Value is null ? "Chưa nhập" : TaxManager.Web.Pages.ForecastModel.FormatAmount(item.Value.Value) + " đồng")@if (item.Value is not null) { <span> — @(item.Value.Status switch { TaxManager.Core.Forecasting.ForecastStatus.Actual => "Thực tế", TaxManager.Core.Forecasting.ForecastStatus.Planned => "Dự kiến", _ => "Giả định" }); Nguồn: @item.Value.Source; Ghi chú: @item.Value.Note; Ngày nhập: @item.Value.EnteredAt.ToString("dd/MM/yyyy HH:mm 'UTC'", System.Globalization.CultureInfo.InvariantCulture)</span> }</p>
}
<h3>Người phụ thuộc và khấu trừ theo tháng</h3><p>Để trống nếu chưa biết; nhập 0 khi xác nhận không phát sinh. Có thể tìm số khấu trừ trên phiếu lương.</p>
@foreach (var item in Model.DependentsPreview.OrderBy(x => x.Key)) {
<p>Người phụ thuộc tháng @item.Key: @(item.Value is null ? "Chưa nhập" : item.Value.Value.ToString())@if (item.Value is not null) { <span> — @(item.Value.Status switch { TaxManager.Core.Forecasting.ForecastStatus.Actual => "Thực tế", TaxManager.Core.Forecasting.ForecastStatus.Planned => "Dự kiến", _ => "Giả định" }); Nguồn: @item.Value.Source; Ghi chú: @item.Value.Note; Ngày nhập: @item.Value.EnteredAt.ToString("dd/MM/yyyy HH:mm 'UTC'", System.Globalization.CultureInfo.InvariantCulture)</span> }</p>
}
@foreach (var item in Model.WithheldPreview.OrderBy(x => x.Key)) {
<p>Khấu trừ tháng @item.Key: @(item.Value is null ? "Chưa nhập" : TaxManager.Web.Pages.ForecastModel.FormatAmount(item.Value.Value) + " đồng")@if (item.Value is not null) { <span> — @(item.Value.Status switch { TaxManager.Core.Forecasting.ForecastStatus.Actual => "Thực tế", TaxManager.Core.Forecasting.ForecastStatus.Planned => "Dự kiến", _ => "Giả định" }); Nguồn: @item.Value.Source; Ghi chú: @item.Value.Note; Ngày nhập: @item.Value.EnteredAt.ToString("dd/MM/yyyy HH:mm 'UTC'", System.Globalization.CultureInfo.InvariantCulture)</span> }</p>
}
</section> }
</main></body></html>
