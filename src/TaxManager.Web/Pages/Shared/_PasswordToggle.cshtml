@model string
@{ var label = Model == "ConfirmPassword" ? "mật khẩu nhập lại" : "mật khẩu"; }
<button type="button" class="password-toggle" data-password-toggle data-password-label="@label" aria-controls="@Model" aria-label="Hiện @label" title="Hiện @label" aria-pressed="false" hidden>
    <span data-password-show><partial name="Shared/_Icon" model='@("preview")' /></span>
    <span data-password-hide hidden><partial name="Shared/_Icon" model='@("eye-off")' /></span>
</button>
