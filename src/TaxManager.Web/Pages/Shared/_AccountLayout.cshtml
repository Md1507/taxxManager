<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>@ViewData["Title"] | TaxManager</title>
    <link rel="preload" href="/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="/site.css" asp-append-version="true" />
    <script src="/workspace.js" defer asp-append-version="true"></script>
</head>
<body class="account-shell">
<a class="skip-link" href="#main">Đến nội dung</a>
<header class="account-header @(ViewData["AccountWide"] is true ? "account-header-wide" : "")"><a class="wordmark" asp-page="/ForecastProfiles"><svg class="brand-mark" viewBox="0 0 28 28" aria-hidden="true" focusable="false"><rect x="1" y="1" width="26" height="26" rx="5" fill="currentColor" /><path d="M7 8h14M14 8v13M7 14h3M7 19h3M18 14h3M18 19h3" /></svg><span>TaxManager</span></a><span class="environment">Demo local</span></header>
<main id="main" class="@(ViewData["AccountWide"] is true ? "account-main-wide" : "account-main-form")" tabindex="-1">@RenderBody()</main>
<footer>Chỉ dùng tài khoản và dữ liệu thử. Kết quả thuế chỉ mang tính tham khảo.</footer>
</body>
</html>
