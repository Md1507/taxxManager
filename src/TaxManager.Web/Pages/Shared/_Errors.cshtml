@if (!ViewData.ModelState.IsValid)
{
    <div class="error-summary" role="alert" tabindex="-1" autofocus="autofocus" aria-labelledby="error-title">
        <h2 id="error-title">Kiểm tra thông tin trước khi tiếp tục</h2>
        <ul>
        @foreach (var entry in ViewData.ModelState.Where(e => e.Value?.Errors.Count > 0)) {
            <li id="error-@Microsoft.AspNetCore.Mvc.Rendering.TagBuilder.CreateSanitizedId(entry.Key, "_")">
            @foreach (var error in entry.Value!.Errors) {
                <div>
                @if (entry.Key.Length > 0) { <a href="#@Microsoft.AspNetCore.Mvc.Rendering.TagBuilder.CreateSanitizedId(entry.Key, "_")">@error.ErrorMessage</a> } else { @error.ErrorMessage }
                </div>
            }
            </li>
        }
        </ul>
    </div>
}
