@{
    var page = ViewContext.RouteData.Values["page"]?.ToString();
    var profile = ViewData["ProfileId"]?.ToString();
    var forecast = page == "/Forecast" ? "" : profile is null ? "/Forecast" : "/Forecast?id=" + profile;
}
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>@ViewData["Title"] | TaxManager</title>
    <link rel="preload" href="/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="/site.css" asp-append-version="true" />
    <script src="/workspace.js" defer asp-append-version="true"></script>
    <script src="/citation.js" defer></script>
</head>
<body data-amount-format="@(ViewContext.HttpContext.Request.HasFormContentType && ViewContext.HttpContext.Request.Form["AmountFormat"] == TaxManager.Web.MoneyInput.GroupedFormat ? TaxManager.Web.MoneyInput.GroupedFormat : "canonical")">
<a class="skip-link" href="#main">Đến nội dung</a>
<div class="app-shell">
    <aside class="sidebar">
        <div class="sidebar-heading"><a class="wordmark" asp-page="/ForecastProfiles"><svg class="brand-mark" viewBox="0 0 28 28" aria-hidden="true" focusable="false"><rect x="1" y="1" width="26" height="26" rx="5" fill="currentColor" /><path d="M7 8h14M14 8v13M7 14h3M7 19h3M18 14h3M18 19h3" /></svg><span>TaxManager</span></a>
        <button class="navigation-toggle" data-navigation-toggle aria-controls="primary-navigation" aria-expanded="true" aria-label="Đóng menu" title="Đóng menu" hidden><span class="visually-hidden" data-navigation-label>Đóng menu</span><span data-navigation-open hidden><partial name="Shared/_Icon" model='@("menu")' /></span><span data-navigation-close><partial name="Shared/_Icon" model='@("close")' /></span></button></div>
        <p class="sidebar-caption">Thuế thu nhập cá nhân</p>
        <nav id="primary-navigation" aria-label="Điều hướng chính">
            <a asp-page="/ForecastProfiles" aria-current="@(page == "/ForecastProfiles" ? "page" : null)"><partial name="Shared/_Icon" model='@("profiles")' />Hồ sơ thuế</a>
            <a href="@(forecast + "#du-lieu")" data-section-link aria-current="@(page == "/Forecast" ? "location" : page == "/ForecastMonth" ? "page" : null)"><partial name="Shared/_Icon" model='@("calendar")' />Dữ liệu 12 tháng</a>
            <a href="@(forecast + "#nguoi-phu-thuoc")" data-section-link><partial name="Shared/_Icon" model='@("people")' />Người phụ thuộc</a>
            <a href="@(forecast + "#tong-quan")" data-section-link aria-current="@(page == "/ForecastScenarios" ? "page" : null)"><partial name="Shared/_Icon" model='@("annual")' />Tổng quan năm</a>
            @if (profile is not null) {
                <a href="/ForecastAnnualHistory?id=@profile" aria-current="@(page == "/ForecastAnnualHistory" ? "page" : null)"><partial name="Shared/_Icon" model='@("history")' />Lịch sử tính</a>
                <a asp-page="/ForecastReport" asp-route-id="@profile" aria-current="@(page == "/ForecastReport" ? "page" : null)"><partial name="Shared/_Icon" model='@("report")' />Báo cáo và checklist</a>
                <a asp-page="/ForecastReconciliation" asp-route-id="@profile" aria-current="@(page == "/ForecastReconciliation" ? "page" : null)"><partial name="Shared/_Icon" model='@("compare")' />Đối chiếu nguồn</a>
            }
            <a href="/" aria-current="@(page == "/Index" ? "page" : null)"><partial name="Shared/_Icon" model='@("calculator")' />Công cụ tính tháng</a>
            <a asp-page="/Backup" aria-current="@(page is "/Backup" or "/Restore" or "/RestorePreview" ? "page" : null)"><partial name="Shared/_Icon" model='@("backup")' />Sao lưu và khôi phục</a>
        </nav>
    </aside>
    <div class="workspace">
        <header class="topbar">@if (Context.RequestServices.GetRequiredService<TaxManager.Web.Backup.SelectedDatabase>().IsRestored) { <span class="environment">Đang dùng kho khôi phục</span> }<span class="environment">Demo local (dữ liệu mẫu)</span>@if (Context.RequestServices.GetRequiredService<TaxManager.Web.Accounts.AccountMode>().Enabled) { <a asp-page="/Accounts/Index">Tài khoản</a> }</header>
        <main id="main" tabindex="-1">@RenderBody()</main>
        <footer>Kết quả chỉ mang tính tham khảo, không thay thế tư vấn thuế chính thức.</footer>
    </div>
</div>
</body>
</html>
